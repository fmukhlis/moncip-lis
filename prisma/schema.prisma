// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PatientSex {
  MALE
  FEMALE
  UNKNOWN
}

enum IntegrationEventType {
  CLINICAL_ORDER_CREATED
  CATALOG_SYNC
  PATIENT_SYNC
}

enum SpecimenRejectionReason {
  INSUFFICIENT_VOLUME
  HEMOLYZED
  CLOTTED
  WRONG_CONTAINER
  MISMATCHED_IDENTITY
  CONTAMINATED
  OTHER
}

enum SpecimenCancellationReason {
  NO_LONGER_NEEDED
  LAB_ORDER_CANCELLED
  DUPLICATE_SPECIMEN
  OTHER
}

enum SpecimenAssignmentEndReason {
  REASSIGNED
  SPECIMEN_REJECTED
  SPECIMEN_CANCELLED
  LAB_ORDER_ITEM_CANCELLED
}

enum InboundIntegrationEventStatus {
  RECEIVED
  PROCESSED
  FAILED
  DUPLICATE
}

enum OutboundIntegrationEventStatus {
  QUEUED
  SENDING
  SENT
  ACKNOWLEDGED
  FAILED
  RETRY_WAITING
  CANCELLED
}

enum ExternalOrderableType {
  TEST
  PANEL
}

enum LisPerformableType {
  SINGLE
  PANEL
}

enum ResultValueType {
  NUMERIC
  TEXT
  CODED
  BOOLEAN
}

enum LabOrderStatus {
  ORDERED
  IN_PROCESS
  COMPLETED
  CANCELLED
}

enum LabOrderItemStatus {
  OPEN
  PRINTED
  COLLECTED
  RECEIVED
  PRELIMINARY
  VERIFIED
  REJECTED
  TNP
  CANCELLED
}

enum LabOrderPriority {
  ROUTINE
  URGENT
  STAT
}

enum Role {
  SYS_ADMIN
  LAB_ADMIN
  DOCTOR
  STAFF
}

enum IntegrationAuthType {
  API_KEY
  BEARER_TOKEN
}

enum SpecimenStatus {
  PENDING
  COLLECTED
  RECEIVED
  REJECTED
  CANCELLED
}

enum AuditLogEntityType {
  SPECIMEN
  LAB_ORDER_ITEM
}

model User {
  id            String          @id @default(cuid(2))
  laboratoryId  String?
  departmentId  String?

  name          String?
  role          Role            @default(SYS_ADMIN)
  email         String?         @unique
  image         String?
  password      String?
  username      String?         @unique
  emailVerified DateTime?
  
  accounts      Account[]
  sessions      Session[]
  auditLogs     AuditLog[]
  collectedSpecimens Specimen[]
  department    Department?     @relation(fields: [departmentId], references: [id])
  laboratory    Laboratory?     @relation(fields: [laboratoryId], references: [id])
  // Optional for WebAuthn support
  Authenticator Authenticator[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// Optional for WebAuthn support
model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

model Laboratory {
  id String @id @default(cuid(2))

  // Relationships
  users                     User[]
  patients                  Patient[]
  auditLogs                 AuditLog[]
  labOrders                 LabOrder[]
  specimens                 Specimen[]
  departments               Department[]
  labOrderItems             LabOrderItem[]
  lisPerformables           LisPerformable[]
  integrationTokens         IntegrationToken[]
  lisResultComponents       LisResultComponent[]
  externalLabOrderables     ExternalLabOrderable[]
  labOrderItemSpecimens     LabOrderItemSpecimen[]
  integrationConnections    IntegrationConnection[]
  integrationCredentials    IntegrationCredential[]
  inboundIntegrationEvents  InboundIntegrationEvent[]
  outboundIntegrationEvents OutboundIntegrationEvent[]
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Department {
  id           String @id @default(cuid(2))
  laboratoryId String

  code        String
  color       String
  isActive    Boolean @default(true)
  displayName String
  description String?

  // Realtionships
  users        User[]
  laboratory   Laboratory       @relation(fields: [laboratoryId], references: [id], onDelete: Cascade)
  performables LisPerformable[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([laboratoryId, code])
  @@index([laboratoryId])
}

