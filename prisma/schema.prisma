// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  laboratoryId  String?
  id            String          @id @default(cuid(2))
  name          String?
  email         String?          @unique
  username      String?          @unique
  emailVerified DateTime?
  image         String?
  role          Role            @default(SYS_ADMIN)
  password      String?
  laboratory    Laboratory?     @relation(fields: [laboratoryId], references: [id])
  accounts      Account[]
  sessions      Session[]
  // Optional for WebAuthn support
  Authenticator Authenticator[]
 
  orderedTestOrder          TestOrder[]       @relation("orderedBy")
  updatedTestOrder          TestOrder[]       @relation("updatedBy")
  canceledTestOrder         TestOrder[]       @relation("canceledBy")
  canceledTestOrderItem     TestOrderItem[]   

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  SYS_ADMIN
  LAB_ADMIN
  DOCTOR
  STAFF
}
 
model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@id([provider, providerAccountId])
}
 
model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
 
model VerificationToken {
  identifier String
  token      String
  expires    DateTime
 
  @@id([identifier, token])
}
 
// Optional for WebAuthn support
model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@id([userId, credentialID])
}

model Laboratory {
  id                          String                        @id @default(cuid(2))

  // Relationships
  users                       User[]
  patients                    Patient[]
  labTestGroups               LabTestGroup[]
  laboratoriesOnLabTests      LaboratoriesOnLabTests[]      

  // Timestamps
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime                      @updatedAt
}

model LaboratoriesOnLabTests {
  id                      String                @id @default(cuid(2))
  notOrderableReason      String?

  // Relationships
  labTest                 LabTest               @relation(fields: [labTestId], references: [id])
  labTestId               String
  laboratory              Laboratory            @relation(fields: [laboratoryId], references: [id])
  laboratoryId            String
  defaultUnit             Unit?                 @relation("defaultUnit", fields: [defaultUnitId], references: [id])
  defaultUnitId           String?
  prices                  Price[]
  referenceRanges         ReferenceRange[]
  labTestGroups           LabTestGroup[]
  testOrderItems          TestOrderItem[]

  // Timestamps
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  deletedAt               DateTime?

  @@unique([labTestId, laboratoryId])
}

model LabTestGroup {
  id                          String                        @id @default(cuid(2))
  code                        String                        
  name                        String
  description                 String?
  notOrderableReason          String?

  // Relationships
  laboratory                  Laboratory                    @relation(fields: [laboratoryId], references: [id])
  laboratoryId                String
  prices                      Price[]
  laboratoriesOnLabTests      LaboratoriesOnLabTests[]

  // Timestamps
  validFrom                   DateTime                      @default(now())
  validTo                     DateTime?
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime                      @updatedAt
  deletedAt                   DateTime?
}

enum AgeUnit {
  M
  Y
}

model ReferenceRange {
  id                            String                      @id @default(cuid(2))
  gender                        Gender
  ageMin                        Int
  ageMinUnit                    AgeUnit
  ageMax                        Int
  ageMaxUnit                    AgeUnit
  valueLow                      Decimal?
  valueHigh                     Decimal?
  normalValues                  String[]                    @default([])

  // Relationships
  unit                          Unit?                       @relation(fields: [unitId], references: [id])
  unitId                        String?
  laboratoriesOnLabTests        LaboratoriesOnLabTests      @relation(fields: [laboratoriesOnLabTestsId], references: [id])
  laboratoriesOnLabTestsId      String
  
  // Timestamps
  validFrom                     DateTime                    @default(now())
  validTo                       DateTime?
  createdAt                     DateTime                    @default(now())
  updatedAt                     DateTime                    @updatedAt
}

enum Gender {
  M
  F
  B
}

model Price {
  id                            String                      @id @default(cuid(2))
  price                         Decimal   
  
  // Relationships
  tariffGroup                   TariffGroup                 @relation(fields: [tariffGroupId], references: [id])
  tariffGroupId                 String
  labTestGroup                  LabTestGroup?               @relation(fields: [labTestGroupId], references: [id])
  labTestGroupId                String?
  laboratoriesOnLabTests        LaboratoriesOnLabTests?     @relation(fields: [laboratoriesOnLabTestsId], references: [id])
  laboratoriesOnLabTestsId      String?

  // Timestamps
  validFrom                     DateTime                    @default(now())
  validTo                       DateTime?
  createdAt                     DateTime                    @default(now())
  updatedAt                     DateTime                    @updatedAt
}

model Patient {
  id                    String          @id @default(cuid(2))
  name                  String
  gender                Gender
  source                Source
  dateOfBirth           DateTime      
  laboratoryId          String
  externalSystemId      String?

  // Relationships
  laboratory            Laboratory      @relation(fields: [laboratoryId], references: [id])
  testOrders            TestOrder[]

  // Timestamps
  createdAt             DateTime        @default(now())
  linkedAt              DateTime?
  deletedAt             DateTime?
}

enum Source {
  MANUAL
  HIS
}

model TestOrder {
  id                    String                  @id @default(cuid(2))
  notes                 String?
  source                OrderSource
  status                OrderStatus
  priority              OrderPriority
  orderNumber           String                  @unique
  cancelReason          String?
  externalSystem        String?
  externalOrderId       String?
  inboundOrderEvents    InboundOrderEvent[]
  
  // Relationships
  patientId             String
  patient               Patient                 @relation(fields: [patientId], references: [id])
  orderedById           String
  orderedBy             User                    @relation("orderedBy", fields: [orderedById], references: [id])
  updatedById           String?
  updatedBy             User?                   @relation("updatedBy", fields: [updatedById], references: [id])
  canceledById          String?
  canceledBy            User?                   @relation("canceledBy", fields: [canceledById], references: [id])
  tariffGroupId         String
  tariffGroup           TariffGroup             @relation(fields: [tariffGroupId], references: [id])
  testOrderItems        TestOrderItem[]

  // Timestamps
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @default(now())
  orderedAt             DateTime
  acknowledgedAt        DateTime?
  sampleCollectedAt     DateTime?
  inProgressAt          DateTime?
  completedAt           DateTime?
  canceledAt            DateTime?
}

enum OrderSource {
  LIS
  HIS
}

enum OrderStatus {
  ORDERED
  ACKNOWLEDGED
  SAMPLE_COLLECTED
  IN_PROGRESS
  COMPLETED
  CANCELED
}

enum OrderPriority {
  ROUTINE
  URGENT
}

model TestOrderItem {
  id                                  String                      @id @default(cuid(2))
  status                              OrderItemStatus
  cancelReason                        String?
  priceSnapshot                       Json

  // Relationships
  testOrderId                         String
  testOrder                           TestOrder                   @relation(fields: [testOrderId], references: [id])
  canceledById                        String?
  canceledBy                          User?                       @relation(fields: [canceledById], references: [id])
  laboratoriesOnLabTestsId            String
  laboratoriesOnLabTests              LaboratoriesOnLabTests      @relation(fields: [laboratoriesOnLabTestsId], references: [id])

  // Timestamps
  createdAt                           DateTime                    @default(now())
  canceledAt                          DateTime?
}

enum OrderItemStatus {
  ORDERED
  CANCELED
  COMPLETED
}

model InboundOrderEvent {
  id                          String                  @id @default(cuid(2))
  status                      EventStatus
  payload                     Json
  eventType                   OrderEventType
  receivedAt                  DateTime                @default(now())
  processedAt                 DateTime?
  sourceSystem                String
  errorMessage                String?
  targetUserIds               String[]
  externalOrderId             String

  // Relationships
  testOrderId                 String?
  testOrder                   TestOrder?              @relation(fields: [testOrderId], references: [id])
}

enum EventStatus {
  RECEIVED
  PROCESSED
  FAILED
}

enum OrderEventType {
  CREATED
  CANCELLED
}

// -------------------------- Statically Generated Data -------------------------- //

model LabTest {
  id                          String                      @id @default(cuid(2))
  code                        String                      @unique
  name                        String
  possibleValues              String[]                    @default([])
  
  scale                       Scale                       @relation(fields: [scaleId], references: [id])
  scaleId                     String
  
  method                      Method?                     @relation(fields: [methodId], references: [id])
  methodId                    String?
  
  category                    Category                    @relation(fields: [categoryId], references: [id])
  categoryId                  String
  
  units                       Unit[]                      @relation("units")
  specimens                   Specimen[]          
  laboratoriesOnLabTests      LaboratoriesOnLabTests[]
}

model Specimen {
  id              String      @id @default(cuid(2))
  code            String      @unique
  name            String
  description     String?
  abbreviation    String

  labTests        LabTest[]   
}

model Category {
  id              String            @id @default(cuid(2))
  code            String            @unique
  name            String
  description     String?

  labTests        LabTest[]
}

model Method {
  id              String      @id @default(cuid(2))
  code            String      @unique
  name            String
  description     String?
  abbreviation    String      

  labTests        LabTest[]
}

model Unit {
  id                          String                        @id @default(cuid(2))
  code                        String                        @unique
  name                        String
  description                 String?
  displayCode                 String

  labTests                    LabTest[]                     @relation("units")
  conversionTo                UnitConversion[]              @relation("toUnit")
  referenceRanges             ReferenceRange[]    
  conversionsFrom             UnitConversion[]              @relation("fromUnit")
  laboratoriesOnLabTests      LaboratoriesOnLabTests[]      @relation("defaultUnit")
}

model Scale {
  id                String        @id @default(cuid(2))
  code              String        @unique
  name              String
  description       String?
  abbreviation      String

  labTests          LabTest[]   
}

model UnitConversion {
  id              String        @id @default(cuid(2))
  factor          Decimal
  offset          Decimal?    
  
  fromUnit        Unit          @relation("fromUnit", fields: [fromUnitId], references: [id])
  fromUnitId      String
  
  toUnit          Unit          @relation("toUnit", fields: [toUnitId], references: [id])
  toUnitId        String

  @@unique([fromUnitId, toUnitId])
}

model TariffGroup {
  id              String      @id @default(cuid(2))
  code            String      @unique
  name            String
  description     String?

  prices          Price[]
  testOrders      TestOrder[]
}

// -------------------------- Statically Generated Data -------------------------- //