model Patient {
  id           String @id @default(cuid(2))
  laboratoryId String

  mrn               String?
  sex               PatientSex @default(UNKNOWN)
  name              String
  phone             String?
  address           String?
  dateOfBirth       DateTime
  lastSnapshot      Json?
  sourceSystem      String
  externalPatientId String?

  // Relationships
  labOrders  LabOrder[]
  specimens  Specimen[]
  laboratory Laboratory @relation(fields: [laboratoryId], references: [id])

  // Timestamps
  linkedAt     DateTime?
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?
  updatedAt    DateTime  @updatedAt
  lastSyncedAt DateTime?

  @@unique([laboratoryId, sourceSystem, externalPatientId])
  @@index([laboratoryId, sourceSystem])
  @@index([laboratoryId, name])
  @@index([laboratoryId, mrn])
}

model IntegrationConnection {
  id           String @id @default(cuid(2))
  laboratoryId String

  name         String
  type         IntegrationAuthType
  baseUrl      String?
  isActive     Boolean             @default(true)
  sourceSystem String

  // Relationships
  tokens             IntegrationToken[]
  credentials        IntegrationCredential[]
  laboratory         Laboratory                 @relation(fields: [laboratoryId], references: [id])
  inboundEvents      InboundIntegrationEvent[]
  outboundEvents     OutboundIntegrationEvent[]
  externalOrderables ExternalLabOrderable[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([laboratoryId, sourceSystem, name])
  @@index([laboratoryId, sourceSystem])
  @@index([laboratoryId, isActive])
}

model IntegrationToken {
  id           String @id @default(cuid(2))
  connectionId String
  laboratoryId String

  name            String
  tokenHash       String  @unique
  tokenPrefix     String
  createdByUserId String?
  revokedByUserId String?

  // Relationships
  connection    IntegrationConnection     @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  laboratory    Laboratory                @relation(fields: [laboratoryId], references: [id])
  inboundEvents InboundIntegrationEvent[]

  // Timestamps
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastUsedAt DateTime?

  @@index([laboratoryId, connectionId])
  @@index([laboratoryId, tokenPrefix])
  @@index([laboratoryId, revokedAt])
}

model IntegrationCredential {
  id           String @id @default(cuid(2))
  connectionId String
  laboratoryId String

  name            String
  secretPrefix    String
  encryptedSecret String
  createdByUserId String?
  revokedByUserId String?

  // Relationships
  connection     IntegrationConnection      @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  laboratory     Laboratory                 @relation(fields: [laboratoryId], references: [id])
  outboundEvents OutboundIntegrationEvent[]

  // Timestamps
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastUsedAt DateTime?

  @@index([laboratoryId, connectionId])
  @@index([laboratoryId, secretPrefix])
  @@index([laboratoryId, revokedAt])
}

model ExternalLabOrderable {
  id           String @id @default(cuid(2))
  connectionId String
  laboratoryId String

  type                ExternalOrderableType @default(TEST)
  isActive            Boolean               @default(true)
  categoryCode        String?
  externalCode        String
  sourceSystem        String
  categoryDisplay     String?
  externalDisplay     String
  externalCodeSystem  String
  rawCatalogSnapshot  Json?
  externalOrderableId String

  // Relationships
  connection    IntegrationConnection @relation(fields: [connectionId], references: [id])
  laboratory    Laboratory            @relation(fields: [laboratoryId], references: [id])
  performables  LisPerformable[]
  labOrderItems LabOrderItem[]

  // Timestamps
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastSyncedAt DateTime?

  @@unique([laboratoryId, sourceSystem, externalCodeSystem, externalCode])
  @@unique([laboratoryId, sourceSystem, externalOrderableId])
  @@index([laboratoryId, sourceSystem])
  @@index([laboratoryId, isActive])
}

model LisPerformable {
  id                  String  @id @default(cuid(2))
  departmentId        String?
  laboratoryId        String
  externalOrderableId String

  type        LisPerformableType @default(SINGLE)
  isActive    Boolean            @default(true)
  displayName String

  // Relationships
  department        Department?                  @relation(fields: [departmentId], references: [id])
  laboratory        Laboratory                   @relation(fields: [laboratoryId], references: [id])
  labOrderItems     LabOrderItem[]
  specimenTypes     LisPerformableSpecimenType[]
  resultComponents  LisResultComponent[]
  externalOrderable ExternalLabOrderable         @relation(fields: [externalOrderableId], references: [id])

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([laboratoryId, externalOrderableId])
  @@index([laboratoryId, departmentId])
  @@index([laboratoryId, isActive])
}

model LisResultComponent {
  id            String  @id @default(cuid(2))
  unitId        String?
  laboratoryId  String
  performableId String

  code          String
  isActive      Boolean         @default(true)
  sortOrder     Int             @default(0)
  valueType     ResultValueType
  isRequired    Boolean         @default(true)
  displayName   String
  decimalPlaces Int?

  // Relationships
  unit        Unit?          @relation(fields: [unitId], references: [id])
  laboratory  Laboratory     @relation(fields: [laboratoryId], references: [id])
  performable LisPerformable @relation(fields: [performableId], references: [id], onDelete: Cascade)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([laboratoryId, performableId, code])
  @@index([laboratoryId, performableId])
  @@index([laboratoryId, isActive])
}

model LabOrder {
  id           String  @id @default(cuid(2))
  patientId    String?
  laboratoryId String

  no                         String
  period                     String
  status                     LabOrderStatus   @default(ORDERED)
  priority                   LabOrderPriority @default(ROUTINE)
  sequence                   Int
  externalId                 String
  externalNo                 String?
  sourceSystem               String
  externalPatientId          String
  externalEncounterId        String
  externalOrderingProviderId String

  // Relationships
  items          LabOrderItem[]
  patient        Patient?                   @relation(fields: [patientId], references: [id])
  specimens      Specimen[]
  laboratory     Laboratory                 @relation(fields: [laboratoryId], references: [id])
  inboundEvents  InboundIntegrationEvent[]
  outboundEvents OutboundIntegrationEvent[]

  // Timestamps
  orderedAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  receivedAt DateTime @default(now())

  @@unique([laboratoryId, no])
  @@unique([laboratoryId, sourceSystem, externalId])
  @@unique([laboratoryId, sourceSystem, externalNo])
  @@index([laboratoryId, patientId])
  @@index([laboratoryId, status, priority])
  @@index([laboratoryId, externalPatientId])
  @@index([laboratoryId, createdAt(sort: Desc)])
}

model LabOrderCounter {
  period    String   @id
  sequence  Int
  updatedAt DateTime @updatedAt
}

model LabOrderItem {
  id                  String @id @default(cuid(2))
  labOrderId          String
  laboratoryId        String
  performableId       String
  externalOrderableId String

  note                        String?
  status                      LabOrderItemStatus @default(OPEN)
  priority                    LabOrderPriority?
  sortOrder                   Int                @default(0)
  performableSnapshot         Json?
  externalOrderItemId         String
  specimenTypeCodeSnapshot    String?
  specimenTypeDisplaySnapshot String?

  // Relationships
  labOrder          LabOrder               @relation(fields: [labOrderId], references: [id], onDelete: Cascade)
  specimens         LabOrderItemSpecimen[]
  laboratory        Laboratory             @relation(fields: [laboratoryId], references: [id])
  performable       LisPerformable         @relation(fields: [performableId], references: [id])
  externalOrderable ExternalLabOrderable   @relation(fields: [externalOrderableId], references: [id])

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([labOrderId, externalOrderItemId])
  @@index([laboratoryId, externalOrderableId])
  @@index([laboratoryId, performableId])
  @@index([laboratoryId, labOrderId])
  @@index([laboratoryId, status])
}

model LabOrderItemSpecimen {
  id             String @id @default(cuid(2))
  specimenId     String
  laboratoryId   String
  labOrderItemId String

  endReason SpecimenAssignmentEndReason?

  // Relationships
  specimen     Specimen     @relation(fields: [specimenId], references: [id], onDelete: Cascade)
  laboratory   Laboratory   @relation(fields: [laboratoryId], references: [id])
  labOrderItem LabOrderItem @relation(fields: [labOrderItemId], references: [id], onDelete: Cascade)

  // Timestamps
  endedAt    DateTime?
  createdAt  DateTime @default(now())
  assignedAt DateTime @default(now())

  @@index([specimenId])
  @@index([labOrderItemId])
  @@index([labOrderItemId, specimenId])
}

model InboundIntegrationEvent {
  id           String  @id @default(cuid(2))
  tokenId      String
  labOrderId   String?
  connectionId String
  laboratoryId String

  status             InboundIntegrationEventStatus @default(RECEIVED)
  errorCode          String?
  eventType          IntegrationEventType
  messageId          String
  errorMessage       String?
  resultSummary      Json?
  idempotencyKey     String
  requestPayload     Json
  externalOrderId    String?
  responsePayload    Json?
  requestPayloadHash String

  // Relationships
  token      IntegrationToken      @relation(fields: [tokenId], references: [id])
  labOrder   LabOrder?             @relation(fields: [labOrderId], references: [id])
  connection IntegrationConnection @relation(fields: [connectionId], references: [id])
  laboratory Laboratory            @relation(fields: [laboratoryId], references: [id])

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@unique([laboratoryId, connectionId, idempotencyKey])
  @@unique([laboratoryId, connectionId, messageId])
  @@index([laboratoryId, connectionId, externalOrderId])
  @@index([laboratoryId, status, receivedAt])
  @@index([laboratoryId, labOrderId])
}

model OutboundIntegrationEvent {
  id           String  @id @default(cuid(2))
  labOrderId   String?
  connectionId String
  credentialId String
  laboratoryId String

  status             OutboundIntegrationEventStatus @default(QUEUED)
  errorCode          String?
  eventType          IntegrationEventType
  messageId          String
  attemptCount       Int                            @default(0)
  errorMessage       String?
  targetSystem       String
  resultSummary      Json?
  idempotencyKey     String
  requestPayload     Json
  externalOrderId    String?
  responsePayload    Json?
  requestPayloadHash String

  // Relationships
  labOrder   LabOrder?             @relation(fields: [labOrderId], references: [id])
  connection IntegrationConnection @relation(fields: [connectionId], references: [id])
  credential IntegrationCredential @relation(fields: [credentialId], references: [id])
  laboratory Laboratory            @relation(fields: [laboratoryId], references: [id])

  // Timestamps
  sentAt         DateTime?
  queuedAt       DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  nextRetryAt    DateTime?
  lastAttemptAt  DateTime?
  acknowledgedAt DateTime?

  @@unique([laboratoryId, targetSystem, idempotencyKey])
  @@unique([laboratoryId, targetSystem, messageId])
  @@index([laboratoryId, targetSystem, externalOrderId])
  @@index([laboratoryId, status, queuedAt])
  @@index([laboratoryId, labOrderId])
  @@index([laboratoryId, credentialId])
}

model LisPerformableSpecimenType {
  specimenTypeId   String
  lisPerformableId String

  isDefault Boolean @default(false)

  specimenType   SpecimenType   @relation(fields: [specimenTypeId], references: [id])
  lisPerformable LisPerformable @relation(fields: [lisPerformableId], references: [id], onDelete: Cascade)

  @@id([lisPerformableId, specimenTypeId])
  @@index([specimenTypeId])
}

model Specimen {
  id             String  @id @default(cuid(2))
  patientId      String
  labOrderId     String
  laboratoryId   String
  specimenTypeId String
  collectedById  String?

  no                 String
  note               String?
  period             String
  status             SpecimenStatus @default(PENDING)
  sequence           Int
  rejectionReason    SpecimenRejectionReason?
  cancellationReason SpecimenCancellationReason?

  // Relationships
  patient      Patient                @relation(fields: [patientId], references: [id])
  labOrder     LabOrder               @relation(fields: [labOrderId], references: [id])
  laboratory   Laboratory             @relation(fields: [laboratoryId], references: [id])
  collectedBy  User?                  @relation(fields: [collectedById], references: [id])
  orderItems   LabOrderItemSpecimen[]
  specimenType SpecimenType           @relation(fields: [specimenTypeId], references: [id])

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  receivedAt  DateTime?
  rejectedAt  DateTime?
  cancelledAt DateTime?
  collectedAt DateTime?

  @@index([laboratoryId, status])
  @@index([laboratoryId, patientId])
  @@index([laboratoryId, labOrderId])
  @@index([laboratoryId, specimenTypeId])
  @@index([laboratoryId, collectedById])
}

model SpecimenCounter {
  period    String   @id
  sequence  Int
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id           String   @id @default(cuid(2))
  actorId      String?
  laboratoryId String

  action     String
  entityId   String
  entityType AuditLogEntityType

  reason   String?
  metadata Json?

  // Timestamps
  createdAt DateTime @default(now())

  // Relationships
  actor      User? @relation(fields: [actorId], references: [id])
  laboratory Laboratory @relation(fields: [laboratoryId], references: [id])

  @@index([laboratoryId, entityType, entityId, createdAt])
  @@index([laboratoryId, action, createdAt])
  @@index([laboratoryId, actorId, createdAt])
}

model OrderSequence {
  id      String @id @default(cuid(2))
  value   Int
  dateKey String @unique
}

// -------------------------- Statically Generated Data -------------------------- //

model SpecimenType {
  id          String  @id @default(cuid(2))
  code        String  @unique
  isActive    Boolean @default(true)
  displayName String
  description String?

  // Relationships
  specimens    Specimen[]
  performables LisPerformableSpecimenType[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Unit {
  id          String  @id @default(cuid(2))
  code        String  @unique
  isActive    Boolean @default(true)
  displayName String
  description String?

  // Relationships
  resultComponents LisResultComponent[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

